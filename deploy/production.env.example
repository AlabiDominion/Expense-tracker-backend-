# Set these in the backend service's Variables screen, not in Git.
# Use the database container's internal network hostname and port 3306.
# URL-encode username/password characters such as @, :, /, # and %.
DATABASE_URL=mysql+pymysql://cloudberth_expenses_app:URL_ENCODED_PASSWORD@INTERNAL_MYSQL_HOST:3306/cloudberth_expenses?charset=utf8mb4
COOKIE_SECURE=true
FRONTEND_URL=https://expense-tracker.pilot.cloudberth.com
CORS_ORIGINS=["https://expense-tracker.pilot.cloudberth.com"]

# Optional until password-reset email is enabled; use your Zoho account's region.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false
